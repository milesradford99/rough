{
  "name": "huajiang",
  "version": "1.0.0",
  "private": true,
  "description": "画讲：把带逐字时间表的口播做成“边画边讲”的手绘视频。给 AI agent 用的分镜与渲染框架，基于 rough.js 笔画引擎。",
  "type": "module",
  "bin": {
    "hj": "bin/hj.mjs"
  },
  "scripts": {
    "hj": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check:examples": "node bin/hj.mjs check examples/compound --strict && node bin/hj.mjs check examples/patterns --strict && node bin/hj.mjs check examples/one-board --strict && node bin/hj.mjs check examples/big-board --strict"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milesradford99/rough.git"
  },
  "keywords": [
    "whiteboard",
    "explainer",
    "hand-drawn",
    "video",
    "storyboard",
    "agent",
    "rough",
    "tts",
    "sync"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.60",
    "@tabler/icons": "^3.30.0",
    "hachure-fill": "^0.5.2",
    "hanzi-writer-data": "^2.0.1",
    "opentype.js": "^1.3.4",
    "path-data-parser": "^0.1.0",
    "points-on-curve": "^0.2.0",
    "points-on-path": "^0.2.1",
    "tsx": "^4.19.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
